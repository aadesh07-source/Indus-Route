{
  "pan_card": {
    "label": "PAN Card",
    "extractable_fields": ["entity_name", "pan_number"],
    "checks": [
      {"id": "pan_format", "param": "pan_number", "type": "regex",
       "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$",
       "description": "PAN number matches the statutory 10-character format."},
      {"id": "pan_matches_profile", "param": "pan_number", "type": "field_hash_equals_profile",
       "profile_field": "pan_hash",
       "description": "PAN on document matches the PAN registered in the business profile."},
      {"id": "entity_name_match", "param": "entity_name", "type": "name_similarity",
       "profile_field": "name", "threshold": 0.75,
       "description": "Entity name on document is consistent with the profile name."}
    ]
  },
  "gst_certificate": {
    "label": "GST Registration Certificate",
    "extractable_fields": ["legal_name", "gstin", "operating_address"],
    "checks": [
      {"id": "gstin_format", "param": "gstin", "type": "regex",
       "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$",
       "description": "GSTIN structure is valid (15 characters)."},
      {"id": "gstin_state_mh", "param": "gstin", "type": "prefix", "value": "27",
       "description": "GSTIN state code is 27 (Maharashtra)."},
      {"id": "gstin_pan_link", "param": "gstin", "type": "gstin_pan_link",
       "profile_field": "pan_hash",
       "description": "PAN embedded inside GSTIN matches the registered PAN."},
      {"id": "address_present", "param": "operating_address", "type": "presence",
       "description": "Operating address is present on the certificate."}
    ]
  },
  "lease_deed": {
    "label": "Lease / MIDC Allotment Deed",
    "extractable_fields": ["plot_number", "expiry_date", "location"],
    "checks": [
      {"id": "plot_number_present", "param": "plot_number", "type": "presence",
       "description": "Plot number is recorded on the deed."},
      {"id": "deed_expiry_valid", "param": "expiry_date", "type": "date_after",
       "min_days": 90,
       "description": "Lease validity extends at least 90 days beyond today."},
      {"id": "location_present", "param": "location", "type": "presence",
       "description": "Industrial location/zone is identifiable."}
    ]
  },
  "factory_layout": {
    "label": "Factory Layout Plan",
    "extractable_fields": ["architect_reg_no", "scale", "total_area_sqft"],
    "checks": [
      {"id": "architect_reg_format", "param": "architect_reg_no", "type": "regex",
       "pattern": "^CA/[0-9]{4}/[0-9]{3,6}$",
       "description": "Council of Architecture registration number format is valid."},
      {"id": "scale_present", "param": "scale", "type": "presence",
       "description": "Drawing scale is stated on the layout."},
      {"id": "area_present", "param": "total_area_sqft", "type": "presence",
       "description": "Total built-up area is stated."}
    ]
  },
  "self_declaration": {
    "label": "Self-Declaration (Statutory Form)",
    "extractable_fields": ["entity_name", "pan_number", "form_hash", "aadhaar_otp_verified"],
    "checks": [
      {"id": "declaration_signed", "param": "aadhaar_otp_verified", "type": "equals",
       "value": true,
       "description": "Declaration is signed via Aadhaar OTP verification."},
      {"id": "declaration_hash_match", "param": "form_hash", "type": "declaration_integrity",
       "description": "Cryptographic hash of the statutory form fields matches."}
    ]
  }
}
