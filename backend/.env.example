# ---- Core (safe defaults; app runs even if you change nothing) ----
SIH_SECRET_KEY=sih26130-dev-secret-change-in-production
SIH_TOKEN_EXPIRE_HOURS=12
SIH_ADMIN_INVITE_CODE=MAHARASHTRA-2026
SIH_DEMO_MODE=true

# ---- Green Channel (extension module) ----
SIH_GREEN_CHANNEL_ENABLED=true
SIH_GC_RATE_LIMIT_PER_DAY=3

# ---- Uploads ----
SIH_MAX_UPLOAD_MB=10

# ---- CORS (comma-separated origins) ----
SIH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- AI layer (optional; falls back to deterministic templates) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Twilio WhatsApp (INDUS ROUTE, WhatsApp-only) ----
# Fill from Twilio Console. TWILIO_WHATSAPP_FROM must be your Twilio
# WhatsApp sender (sandbox: whatsapp:+14155238886 after joining with
# "join <code>"; production: whatsapp:+<your approved business number>).
# TWILIO_WHATSAPP_TO is only a fallback test recipient (your own number).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Recommended instead of Auth Token: API Key SID + Secret (same account).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
# Optional: approved WhatsApp template SIDs (Content Template Builder HX...).
# Required for production senders initiating outside the 24h window.
TWILIO_CONTENT_SID_GENERIC=
TWILIO_CONTENT_SID_OTP=
TWILIO_CONTENT_SID_SUBMITTED=
TWILIO_CONTENT_SID_SANCTIONED=
TWILIO_CONTENT_SID_SENTBACK=
